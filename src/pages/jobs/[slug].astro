---
import Base from '../../layouts/Base.astro';
import { getJobs } from '../../lib/jobs.js';

const data = await getJobs();
const job = data.jobs.find((j) => j.slug === Astro.params.slug);
if (!job) {
  return new Response('Not found', { status: 404 });
}
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = root || '/';
const canonical = new URL(`${root}/jobs/${job.slug}`, Astro.site).href;

// Split the plaintext description into renderable blocks (bullets vs paragraphs).
const blocks = (job.description || '')
  .split('\n')
  .map((line) => line.trim())
  .filter(Boolean)
  .map((line) => (line.startsWith('•') ? { type: 'li', text: line.replace(/^•\s*/, '') } : { type: 'p', text: line }));
const hasDescription = blocks.length > 0;
const isLong = (job.description || '').length > 420;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: job.title,
  datePosted: job.postedAt || job.firstSeen,
  hiringOrganization: { '@type': 'Organization', name: job.company },
  jobLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: job.location },
  },
  ...(job.remote ? { jobLocationType: 'TELECOMMUTE' } : {}),
  ...(job.description ? { description: job.description } : {}),
  employmentType: 'FULL_TIME',
  directApply: false,
  // Keep listings from reading as stale: valid 60 days from when we first saw it.
  validThrough: new Date(new Date(job.postedAt || job.firstSeen).getTime() + 60 * 864e5).toISOString(),
  url: canonical,
};
---
<Base
  title={`${job.title} at ${job.company} — Kodex Community Job Board`}
  description={`${job.title} at ${job.company} (${job.location}). Found via the Kodex Community Job Board.`}
  canonical={canonical}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article class="job">
    <a class="back" href={home}>← All roles</a>
    <div class="job-head">
      <p class="company">{job.company}</p>
      <h1>{job.title}</h1>
      <div class="tags">
        <span class="pill">{job.roleCategory}</span>
        {job.remote && <span class="pill remote">Remote</span>}
      </div>
    </div>

    <dl class="facts">
      <div><dt>Location</dt><dd>{job.location}</dd></div>
      {job.excerpt && <div><dt>Team</dt><dd>{job.excerpt}</dd></div>}
      <div><dt>Listed</dt><dd>{new Date(job.postedAt || job.firstSeen).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</dd></div>
      <div><dt>Source</dt><dd class="cap">{job.source}</dd></div>
    </dl>

    {hasDescription && (
      <section class="description">
        <h2>About this role</h2>
        <div class={`desc-body${isLong ? ' clamped' : ''}`} id="desc">
          {blocks.map((b) => (b.type === 'li' ? <p class="li">{b.text}</p> : <p>{b.text}</p>))}
        </div>
        {isLong && (
          <button type="button" class="read-more" id="readMore" aria-expanded="false" aria-controls="desc">
            Read more
          </button>
        )}
        <p class="src-note">Excerpt from {job.company}'s posting. Read the full description and apply below.</p>
      </section>
    )}

    <a class="apply" href={job.applyUrl} target="_blank" rel="noopener">
      Apply at {job.company} ↗
    </a>
    <p class="note">
      You'll apply directly on {job.company}'s official careers page. Kodex curates this board
      but isn't involved in hiring for this role.
    </p>
  </article>
</Base>

<style>
  .job { max-width: 680px; padding-top: 48px; }
  .back { font-size: 14px; color: var(--ink-subtle); }
  .back:hover { color: var(--ink); }
  .job-head { padding: 28px 0 4px; }
  .company { font-size: 13px; font-weight: 500; letter-spacing: 0.4px; color: var(--ink-subtle); margin: 0 0 8px; }
  h1 {
    font-size: clamp(28px, 4.5vw, 40px); font-weight: 600;
    letter-spacing: -1px; line-height: 1.15; margin: 0 0 16px;
  }
  .tags { display: flex; gap: 6px; }

  .facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px;
    background: var(--hairline); border: 1px solid var(--hairline); border-radius: 12px;
    overflow: hidden; margin: 28px 0;
  }
  .facts > div { background: var(--surface-1); padding: 14px 18px; }
  dt { font-size: 12px; letter-spacing: 0.4px; text-transform: uppercase; color: var(--ink-tertiary); margin-bottom: 3px; }
  dd { margin: 0; font-size: 15px; font-weight: 500; color: var(--ink); }
  .cap { text-transform: capitalize; }

  .description { margin: 28px 0; }
  .description h2 {
    font-size: 18px; font-weight: 600; letter-spacing: -0.3px; margin: 0 0 14px;
  }
  .desc-body { position: relative; }
  .desc-body p { font-size: 15px; line-height: 1.6; color: var(--ink-muted); margin: 0 0 12px; }
  .desc-body p.li { padding-left: 18px; position: relative; }
  .desc-body p.li::before { content: '•'; position: absolute; left: 4px; color: var(--ink-subtle); }
  .desc-body.clamped {
    max-height: 240px; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 65%, transparent 100%);
  }
  .read-more {
    font: inherit; font-size: 14px; font-weight: 500; cursor: pointer;
    color: var(--primary); background: none; border: none; padding: 4px 0; margin-top: 2px;
  }
  .read-more:hover { color: var(--primary-hover); }
  .src-note { font-size: 12px; color: var(--ink-tertiary); margin: 10px 0 0; }

  .apply {
    display: inline-block; font-size: 14px; font-weight: 500; line-height: 1.2;
    color: #ffffff; background: var(--primary);
    border-radius: 8px; padding: 10px 16px;
    transition: background 0.12s ease;
  }
  .apply:hover { background: var(--primary-hover); }
  .note { font-size: 13px; color: var(--ink-tertiary); margin-top: 18px; max-width: 46ch; }
</style>

<script>
  const btn = document.getElementById('readMore');
  const desc = document.getElementById('desc');
  if (btn && desc) {
    btn.addEventListener('click', () => {
      const expanded = desc.classList.toggle('clamped') === false;
      btn.textContent = expanded ? 'Show less' : 'Read more';
      btn.setAttribute('aria-expanded', String(expanded));
    });
  }
</script>
