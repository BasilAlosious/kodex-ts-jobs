---
import Base from '../layouts/Base.astro';
import { getJobs } from '../lib/jobs.js';

const data = await getJobs();
const jobs = data.jobs;
const companies = [...new Set(jobs.map((j) => j.company))].sort();
const categories = [...new Set(jobs.map((j) => j.roleCategory))].sort();
const updated = new Date(data.generatedAt).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
---
<Base
  title="Trust & Safety Jobs — Kodex"
  description={`${jobs.length} open Trust & Safety, law enforcement response, and financial crime roles across ${companies.length} companies. Curated by Kodex, refreshed weekly.`}
>
  <section class="hero">
    <p class="eyebrow">Refreshed weekly · {updated}</p>
    <h1>Trust &amp; Safety Jobs</h1>
    <p class="hero-sub">
      Open roles in law enforcement response, investigations, trust &amp; safety,
      and financial crime — pulled straight from company career boards.
    </p>
    <p class="hero-meta">
      <strong>{jobs.length}</strong> open roles across <strong>{companies.length}</strong> companies
    </p>
  </section>

  <section class="controls" aria-label="Filter jobs">
    <input id="search" type="search" placeholder="Search title, company, location…" autocomplete="off" />
    <div class="control-row">
      <div class="cat-pills" id="cat-pills" role="group" aria-label="Filter by category">
        <button class="cat-pill active" data-cat="">All</button>
        {categories.map((c) => <button class="cat-pill" data-cat={c}>{c}</button>)}
      </div>
    </div>
    <div class="control-row secondary">
      <select id="company" aria-label="Filter by company">
        <option value="">All companies</option>
        {companies.map((c) => <option value={c}>{c}</option>)}
      </select>
      <label class="remote-toggle">
        <input type="checkbox" id="remote" /> Remote only
      </label>
      <span class="count" id="count">{jobs.length} roles</span>
    </div>
  </section>

  <section class="board" id="board">
    {jobs.map((job) => (
      <a
        class="job-card"
        href={`/jobs/${job.slug}/`}
        data-title={job.title.toLowerCase()}
        data-company={job.company}
        data-location={job.location.toLowerCase()}
        data-cat={job.roleCategory}
        data-remote={job.remote ? '1' : ''}
      >
        <div class="job-main">
          <h2>{job.title}</h2>
          <p class="job-meta">
            <span class="job-company">{job.company}</span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{job.location}</span>
          </p>
        </div>
        <div class="job-tags">
          <span class="pill">{job.roleCategory}</span>
          {job.remote && <span class="pill remote">Remote</span>}
        </div>
      </a>
    ))}
    <p class="empty" id="empty" hidden>No roles match those filters — try broadening.</p>
  </section>
</Base>

<style>
  .hero { padding: 64px 0 8px; max-width: 640px; }
  .eyebrow {
    font-size: 13px; font-weight: 500; letter-spacing: 0.4px;
    color: var(--ink-subtle); margin: 0 0 16px; text-transform: none;
  }
  h1 {
    font-size: clamp(36px, 5.5vw, 56px); font-weight: 600;
    letter-spacing: -1.8px; line-height: 1.1; margin: 0 0 14px;
  }
  .hero-sub { font-size: 18px; letter-spacing: -0.1px; color: var(--ink-muted); margin: 0 0 10px; line-height: 1.5; }
  .hero-meta { font-size: 14px; color: var(--ink-subtle); margin: 0; }
  .hero-meta strong { color: var(--ink); font-weight: 500; }

  .controls { padding: 32px 0 8px; display: flex; flex-direction: column; gap: 14px; }
  #search {
    width: 100%; max-width: 460px; font: inherit; font-size: 15px;
    color: var(--ink); background: var(--surface-1);
    border: 1px solid var(--hairline); border-radius: 8px; padding: 8px 12px;
  }
  #search:focus { outline: 2px solid var(--primary-focus); outline-offset: 0; border-color: transparent; }
  #search::placeholder { color: var(--ink-tertiary); }

  .cat-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .cat-pill {
    font: inherit; font-size: 14px; font-weight: 500; line-height: 1.2; cursor: pointer;
    color: var(--ink-subtle); background: var(--canvas);
    border: 1px solid var(--hairline); border-radius: 9999px; padding: 6px 14px;
    transition: color 0.12s ease, background 0.12s ease, border-color 0.12s ease;
  }
  .cat-pill:hover { color: var(--ink); border-color: var(--hairline-strong); }
  .cat-pill.active {
    color: var(--ink); background: var(--surface-2); border-color: var(--hairline-strong);
  }

  .control-row.secondary { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  #company {
    font: inherit; font-size: 14px; color: var(--ink); background: var(--surface-1);
    border: 1px solid var(--hairline); border-radius: 8px; padding: 7px 10px;
  }
  #company option { color: var(--ink); background: var(--surface-2); }
  .remote-toggle { font-size: 14px; color: var(--ink-subtle); display: flex; align-items: center; gap: 7px; cursor: pointer; }
  .remote-toggle input { accent-color: var(--primary); width: 15px; height: 15px; }
  .count { font-size: 12px; color: var(--ink-tertiary); margin-left: auto; font-variant-numeric: tabular-nums; }

  .board { display: flex; flex-direction: column; gap: 8px; padding-top: 20px; }
  .job-card {
    display: flex; justify-content: space-between; align-items: center; gap: 18px;
    background: var(--surface-1); border: 1px solid var(--hairline);
    border-radius: 12px; padding: 16px 20px;
    color: var(--ink);
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .job-card:hover { background: var(--surface-2); border-color: var(--hairline-strong); }
  .job-main { min-width: 0; }
  .job-card h2 { font-size: 16px; font-weight: 500; letter-spacing: -0.2px; margin: 0 0 3px; }
  .job-meta { font-size: 14px; color: var(--ink-subtle); margin: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .job-company { color: var(--ink-muted); font-weight: 500; }
  .dot { color: var(--ink-tertiary); }
  .job-tags { display: flex; gap: 6px; flex-shrink: 0; }
  .empty { color: var(--ink-subtle); padding: 32px 4px; }

  @media (max-width: 640px) {
    .job-card { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>

<script>
  const search = document.getElementById('search') as HTMLInputElement;
  const company = document.getElementById('company') as HTMLSelectElement;
  const remote = document.getElementById('remote') as HTMLInputElement;
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.cat-pill')];
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.job-card')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  let activeCat = '';

  function apply() {
    const q = search.value.trim().toLowerCase();
    const co = company.value;
    const remoteOnly = remote.checked;
    let shown = 0;
    for (const card of cards) {
      const d = card.dataset;
      const matches =
        (!q || d.title!.includes(q) || d.company!.toLowerCase().includes(q) || d.location!.includes(q)) &&
        (!co || d.company === co) &&
        (!activeCat || d.cat === activeCat) &&
        (!remoteOnly || d.remote === '1');
      card.style.display = matches ? '' : 'none';
      if (matches) shown++;
    }
    count.textContent = `${shown} role${shown === 1 ? '' : 's'}`;
    empty.hidden = shown > 0;
  }

  search.addEventListener('input', apply);
  company.addEventListener('change', apply);
  remote.addEventListener('change', apply);
  for (const pill of pills) {
    pill.addEventListener('click', () => {
      activeCat = pill.dataset.cat!;
      pills.forEach((p) => p.classList.toggle('active', p === pill));
      apply();
    });
  }
</script>
