---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
// Mount-path root with NO trailing slash ('' locally, '/mount-path' on Webflow
// Cloud). Join child paths as `${root}/child` so it works in both cases.
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = root || '/';
const canonicalUrl = canonical || new URL(root || '/', Astro.site).href;
const ogImage = new URL(`${root}/favicon.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="icon" type="image/png" href={`${root}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${root}/favicon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kodex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="frame">
      <header class="site-header">
        <a class="brand" href={home} aria-label="Kodex — home">
          <img src={`${root}/kodex-logo.png`} alt="Kodex" width="128" height="37" class="brand-logo" />
        </a>
        <span class="header-tag">Community Job Board</span>
      </header>
      <slot />
      <footer class="site-footer">
        <div class="newsletter">
          <p class="newsletter-copy">Subscribe for regular updates on trust &amp; safety jobs.</p>
          <div id="hs-newsletter" class="hs-newsletter"></div>
        </div>
        <p class="footer-note">
          Curated by <a href="https://kodexglobal.com">Kodex</a> — the portal for managing law
          enforcement data requests. Roles link to each company's official careers page.
        </p>
      </footer>
    </div>

    <script charset="utf-8" type="text/javascript" src="//js.hsforms.net/forms/embed/v2.js" is:inline></script>
    <script is:inline>
      hbspt.forms.create({
        portalId: "44165336",
        formId: "58e8848d-5d6b-4e0f-a777-bd4a5062635e",
        region: "na1",
        target: "#hs-newsletter",
      });
    </script>
  </body>
</html>

<style is:global>
  /* Linear-style system per DESIGN-linear.app.md */
  :root {
    --canvas: #010102;
    --surface-1: #0f1011;
    --surface-2: #141516;
    --surface-3: #18191a;
    --hairline: #23252a;
    --hairline-strong: #34343a;
    --ink: #f7f8f8;
    --ink-muted: #d0d6e0;
    --ink-subtle: #8a8f98;
    --ink-tertiary: #62666d;
    --primary: #5e6ad2;
    --primary-hover: #828fff;
    --primary-focus: #5e69d1;
    --success: #27a644;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: 'Inter', 'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif;
    background: var(--canvas);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.05px;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--ink); text-decoration: none; }
  .frame { max-width: 1060px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }

  .site-header {
    display: flex; align-items: center; gap: 14px;
    height: 56px; border-bottom: 1px solid var(--hairline);
  }
  .brand {
    display: flex; align-items: center;
  }
  .brand-logo {
    height: 22px; width: auto; display: block;
  }
  .header-tag {
    font-size: 13px; font-weight: 500; letter-spacing: 0.4px; color: var(--ink-subtle);
    border: 1px solid var(--hairline); border-radius: 9999px; padding: 2px 10px;
  }

  .site-footer {
    border-top: 1px solid var(--hairline); margin-top: 96px; padding: 40px 0 56px;
    font-size: 12px; line-height: 1.4; color: var(--ink-subtle);
  }
  .site-footer a { color: var(--ink-muted); }
  .site-footer a:hover { color: var(--ink); }

  .newsletter { max-width: 440px; margin-bottom: 40px; }
  .newsletter-copy {
    font-size: 15px; line-height: 1.5; color: var(--ink-muted);
    margin: 0 0 16px; letter-spacing: -0.1px;
  }
  .footer-note { margin: 0; }

  /* HubSpot form → Linear dark theme. The form renders inline (the classes
     below are real page elements), so these overrides apply. !important is
     needed to beat HubSpot's own inline/stylesheet rules. */
  #hs-newsletter .hs-form-field { margin-bottom: 12px; }
  #hs-newsletter .hs-form-field > label {
    display: block; font-size: 12px !important; font-weight: 500 !important;
    color: var(--ink-subtle) !important; margin-bottom: 6px;
  }
  #hs-newsletter .hs-form-required { color: var(--primary); margin-left: 2px; }
  #hs-newsletter .hs-input {
    width: 100% !important; max-width: 340px; box-sizing: border-box;
    font: inherit !important; font-size: 14px !important; color: var(--ink) !important;
    background: var(--surface-1) !important; border: 1px solid var(--hairline-strong) !important;
    border-radius: 8px !important; padding: 9px 12px !important; box-shadow: none !important;
  }
  #hs-newsletter .hs-input:focus {
    outline: 2px solid var(--primary-focus) !important; outline-offset: 0;
    border-color: transparent !important;
  }
  #hs-newsletter .hs-input::placeholder { color: var(--ink-tertiary); }
  #hs-newsletter .hs-input.error,
  #hs-newsletter .hs-input.invalid { border-color: #ff8f8f !important; }
  #hs-newsletter .hs-button {
    font: inherit !important; font-size: 14px !important; font-weight: 500 !important;
    cursor: pointer; color: #fff !important; background: var(--primary) !important;
    border: none !important; border-radius: 8px !important; padding: 10px 18px !important;
    margin-top: 4px; box-shadow: none !important; text-shadow: none !important;
    transition: background 0.12s ease;
  }
  #hs-newsletter .hs-button:hover { background: var(--primary-hover) !important; }
  #hs-newsletter .hs-error-msg,
  #hs-newsletter .hs-error-msgs label { color: #ff8f8f !important; font-size: 12px !important; }
  #hs-newsletter .legal-consent-container,
  #hs-newsletter .hs-richtext,
  #hs-newsletter .hs-richtext p {
    font-size: 11px !important; color: var(--ink-tertiary) !important; line-height: 1.4;
  }
  #hs-newsletter .legal-consent-container a,
  #hs-newsletter .hs-richtext a { color: var(--ink-muted); }
  #hs-newsletter .submitted-message,
  #hs-newsletter .hs-main-font-element { color: var(--ink-muted) !important; font-size: 14px !important; }

  .pill {
    display: inline-flex; align-items: center;
    font-size: 12px; font-weight: 500;
    padding: 2px 8px; border-radius: 9999px;
    background: var(--surface-2); color: var(--ink-muted);
    white-space: nowrap;
  }
  .pill.remote { color: var(--success); }

  :focus-visible { outline: 2px solid var(--primary-focus); outline-offset: 1px; }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
