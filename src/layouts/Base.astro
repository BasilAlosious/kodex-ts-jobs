---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL; // '/' locally, '/mount-path/' on Webflow Cloud
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="frame">
      <header class="site-header">
        <a class="brand" href={base} aria-label="Kodex — home">
          <img src={`${base}kodex-logo.png`} alt="Kodex" width="128" height="37" class="brand-logo" />
        </a>
        <span class="header-tag">Trust &amp; Safety Jobs</span>
      </header>
      <slot />
      <footer class="site-footer">
        <p>
          Curated by <a href="https://kodexglobal.com">Kodex</a> — the portal for managing law
          enforcement data requests. Roles link to each company's official careers page.
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* Linear-style system per DESIGN-linear.app.md */
  :root {
    --canvas: #010102;
    --surface-1: #0f1011;
    --surface-2: #141516;
    --surface-3: #18191a;
    --hairline: #23252a;
    --hairline-strong: #34343a;
    --ink: #f7f8f8;
    --ink-muted: #d0d6e0;
    --ink-subtle: #8a8f98;
    --ink-tertiary: #62666d;
    --primary: #5e6ad2;
    --primary-hover: #828fff;
    --primary-focus: #5e69d1;
    --success: #27a644;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: 'Inter', 'SF Pro Display', -apple-system, system-ui, 'Segoe UI', Roboto, sans-serif;
    background: var(--canvas);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: -0.05px;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--ink); text-decoration: none; }
  .frame { max-width: 1060px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 32px); }

  .site-header {
    display: flex; align-items: center; gap: 14px;
    height: 56px; border-bottom: 1px solid var(--hairline);
  }
  .brand {
    display: flex; align-items: center;
  }
  .brand-logo {
    height: 22px; width: auto; display: block;
  }
  .header-tag {
    font-size: 13px; font-weight: 500; letter-spacing: 0.4px; color: var(--ink-subtle);
    border: 1px solid var(--hairline); border-radius: 9999px; padding: 2px 10px;
  }

  .site-footer {
    border-top: 1px solid var(--hairline); margin-top: 96px; padding: 32px 0 48px;
    font-size: 12px; line-height: 1.4; color: var(--ink-subtle);
  }
  .site-footer a { color: var(--ink-muted); }
  .site-footer a:hover { color: var(--ink); }

  .pill {
    display: inline-flex; align-items: center;
    font-size: 12px; font-weight: 500;
    padding: 2px 8px; border-radius: 9999px;
    background: var(--surface-2); color: var(--ink-muted);
    white-space: nowrap;
  }
  .pill.remote { color: var(--success); }

  :focus-visible { outline: 2px solid var(--primary-focus); outline-offset: 1px; }

  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }
</style>
