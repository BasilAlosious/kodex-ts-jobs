{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kodex-ts-jobs",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "observability": { "enabled": true }
}
